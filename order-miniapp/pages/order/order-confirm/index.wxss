page { background: #f5f7f8; }
.checkout-page { min-height: 100vh; padding: 24rpx; padding-bottom: 160rpx; box-sizing: border-box; }
.state, .error { padding: 150rpx 20rpx; text-align: center; color: #839197; font-size: 28rpx; }
.error { color: #a64e35; background: #fff0ea; text-align: left; }
.section { background: #fff; border-radius: 10rpx; padding: 24rpx; margin-bottom: 20rpx; }
.section-title { display: flex; align-items: center; justify-content: space-between; color: #23343b; font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.link-button { margin: 0; padding: 0; border: 0; background: transparent; color: #176b80; font-size: 24rpx; }
.link-button::after { border: 0; }
.address-picker { padding: 24rpx; background: #f2f7f7; color: #34484f; font-size: 25rpx; line-height: 1.5; }
.address-picker text { float: right; color: #176b80; }
.empty-address { color: #9aa6aa; font-size: 25rpx; padding: 20rpx 0; }
.address-form { margin-top: 20rpx; }
.address-form input { height: 74rpx; border-bottom: 1rpx solid #e3e9ea; font-size: 25rpx; }
.save-button { margin: 20rpx 0 0; background: #176b80; color: #fff; font-size: 26rpx; }
.order-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #eef1f2; gap: 18rpx; }
.item-icon { flex: 0 0 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #e5f0f1; color: #176b80; font-size: 23rpx; overflow: hidden; white-space: nowrap; }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; color: #23343b; font-size: 27rpx; }
.muted { color: #8b989d; font-size: 23rpx; }
.item-price { color: #a64e35; font-size: 25rpx; }
.total-section { background: #fff; padding: 28rpx 24rpx; display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #52636a; }
.total { color: #a64e35; font-size: 40rpx; font-weight: 700; }
.submit-button { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #176b80; color: #fff; font-size: 28rpx; z-index: 5; }
