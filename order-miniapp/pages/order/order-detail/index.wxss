page { background: #f5f7f8; }.detail-page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }.state,.error { padding: 150rpx 20rpx; text-align: center; color: #87969b; font-size: 27rpx; }.error { color: #a64e35; background: #fff0ea; padding: 24rpx; text-align: left; }.status-card { display: flex; flex-direction: column; gap: 8rpx; padding: 30rpx; background: #123d4a; color: #fff; border-radius: 9rpx; }.status-label,.order-no { color: #b9d0d6; font-size: 23rpx; }.status { font-size: 38rpx; font-weight: 700; }.section { margin-top: 20rpx; padding: 24rpx; background: #fff; border-radius: 9rpx; }.section-title { color: #24363d; font-size: 29rpx; font-weight: 600; margin-bottom: 18rpx; }.item { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-top: 1rpx solid #eef1f2; }.item-mark { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; background: #e5f0f1; color: #176b80; font-size: 20rpx; }.item-info { display: flex; flex: 1; flex-direction: column; gap: 8rpx; font-size: 26rpx; }.muted { color: #89979c; font-size: 22rpx; }.price,.total { color: #a64e35; font-weight: 700; }.address { display: flex; flex-direction: column; gap: 8rpx; color: #52646b; font-size: 26rpx; }.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; color: #74848b; font-size: 25rpx; }.summary text:nth-child(2),.summary text:nth-child(4) { text-align: right; }.detail-page button { margin-top: 28rpx; background: #176b80; color: #fff; font-size: 27rpx; }
.confirm-button { background: #176b80 !important; color: #fff; }
