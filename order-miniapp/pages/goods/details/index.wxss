page { background: #f5f7f8; }
.detail-page { min-height: 100vh; padding-bottom: 150rpx; }.state, .error { padding: 180rpx 24rpx; text-align: center; color: #87969b; font-size: 27rpx; }.error { color: #a64e35; background: #fff0ea; padding: 24rpx; text-align: left; }
.detail-image { height: 500rpx; display: flex; align-items: center; justify-content: center; background: #e5f0f1; color: #176b80; font-size: 58rpx; font-weight: 700; text-align: center; padding: 40rpx; box-sizing: border-box; }.detail-card { margin: 20rpx 24rpx; padding: 26rpx; background: #fff; border-radius: 10rpx; }.detail-category { color: #176b80; font-size: 24rpx; }.detail-name { color: #263940; font-size: 40rpx; font-weight: 700; margin-top: 10rpx; }.detail-price { color: #a64e35; font-size: 44rpx; font-weight: 700; margin-top: 22rpx; }.detail-stock { color: #7f8f94; font-size: 24rpx; margin-top: 10rpx; }.detail-description { border-top: 1rpx solid #edf1f2; margin-top: 22rpx; padding-top: 22rpx; color: #64757b; font-size: 27rpx; line-height: 1.7; }.detail-bottom { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06); }.detail-bottom button { flex: 1; margin: 0; font-size: 27rpx; }.cart-button { color: #176b80; background: #e9f3f5; }.add-button { color: #fff; background: #176b80; }
