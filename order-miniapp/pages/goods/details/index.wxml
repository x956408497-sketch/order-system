<view class="detail-page">
  <view wx:if="{{loading}}" class="state">正在加载商品...</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <image wx:if="{{product.imageUrl}}" class="detail-image" src="{{product.imageUrl}}" mode="aspectFill" />
    <view wx:else class="detail-image">{{product.name}}</view>
    <view class="detail-card">
      <view class="detail-category">{{product.categoryName}}</view>
      <view class="detail-name">{{product.name}}</view>
      <view class="detail-price">¥{{priceText}}</view>
      <view class="detail-stock">库存：{{product.stock}} 件</view>
      <view class="detail-description">{{product.description || '暂无商品描述'}}</view>
    </view>
    <view class="detail-bottom"><button bindtap="goCart" class="cart-button">购物车</button><button bindtap="addToCart" class="add-button" disabled="{{product.stock <= 0}}">{{product.stock > 0 ? '加入购物车' : '暂时缺货'}}</button></view>
  </block>
</view>
