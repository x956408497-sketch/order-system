page {
  background: #f5f7f8;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.header {
  padding: 18rpx 4rpx 24rpx;
}

.brand {
  color: #123d4a;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  color: #839197;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.search-box {
  background: #ffffff;
  border: 1rpx solid #dfe7e9;
  border-radius: 8rpx;
  padding: 0 24rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-box input {
  width: 100%;
  color: #23343b;
  font-size: 28rpx;
}

.error-box {
  background: #fff0ea;
  border: 1rpx solid #f1c5b5;
  color: #a34d36;
  padding: 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.loading,
.empty {
  color: #89979c;
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.product-card {
  overflow: hidden;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 55, 65, 0.06);
}

.product-image {
  height: 210rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6f0f1;
  color: #1b6b7f;
  font-size: 68rpx;
  font-weight: 700;
}

.product-info {
  padding: 18rpx;
}

.product-category {
  color: #1d7488;
  font-size: 20rpx;
}

.product-name {
  color: #1c2b31;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 7rpx;
}

.product-description {
  color: #8a969a;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 6rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
}

.price {
  color: #b65d37;
  font-size: 32rpx;
  font-weight: 700;
}

.cart-button {
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  border: 0;
  border-radius: 6rpx;
  background: #176b80;
  color: #ffffff;
  font-size: 23rpx;
}

.cart-button::after {
  border: 0;
}
