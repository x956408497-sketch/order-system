<view class="page">
  <view class="header">
    <view class="brand">在线订货</view>
    <view class="subtitle">商品商城</view>
  </view>

  <view class="search-box">
    <input value="{{keyword}}" bindinput="onSearchInput" placeholder="搜索商品名称" confirm-type="search" />
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在加载商品...</view>

  <view wx:elif="{{!visibleProducts.length}}" class="empty">暂无上架商品</view>

  <view wx:else class="product-grid">
    <view wx:for="{{visibleProducts}}" wx:key="id" class="product-card" data-product="{{item}}" bindtap="openProduct">
      <view class="product-image">{{item.firstChar}}</view>
      <view class="product-info">
        <view class="product-category">{{item.categoryName}}</view>
        <view class="product-name">{{item.name}}</view>
        <view class="product-description">{{item.description || '品质商品，放心选购'}}</view>
        <view class="product-bottom">
          <text class="price">¥{{item.priceText}}</text>
          <button class="cart-button" data-product="{{item}}" catchtap="addToCart">加入</button>
        </view>
      </view>
    </view>
  </view>
</view>
