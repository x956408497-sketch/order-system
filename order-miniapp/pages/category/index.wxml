<view class="category-page">
  <view class="category-title">商品分类</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <scroll-view class="category-tabs" scroll-x="true">
    <view class="category-tab {{selectedCategoryId === null ? 'active' : ''}}" bindtap="selectAll">全部</view>
    <view wx:for="{{categories}}" wx:key="id" class="category-tab {{selectedCategoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view>
  </scroll-view>
  <view wx:if="{{loading}}" class="state">正在加载商品...</view>
  <view wx:elif="{{!products.length}}" class="state">该分类暂无商品</view>
  <view wx:else class="product-list">
    <view wx:for="{{products}}" wx:key="id" class="product-row" data-id="{{item.id}}" bindtap="openProduct">
      <image wx:if="{{item.imageUrl}}" class="product-mark" src="{{item.imageUrl}}" mode="aspectFill" /><view wx:else class="product-mark">{{item.name}}</view>
      <view class="product-main"><view class="product-name">{{item.name}}</view><view class="category-name">{{item.categoryName}}</view><view class="description">{{item.description || '品质商品，放心选购'}}</view><view class="product-foot"><text>¥{{item.price}}</text><button data-product="{{item}}" catchtap="addToCart">加入购物车</button></view></view>
    </view>
  </view>
</view>
