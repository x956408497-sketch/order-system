page { background: #f5f7f8; }
.mine-page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; padding-bottom: 140rpx; }
.profile { display: flex; align-items: center; gap: 20rpx; padding: 36rpx 24rpx; background: #123d4a; color: #fff; border-radius: 10rpx; }
.avatar { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #e5a05b; border-radius: 50%; font-size: 34rpx; font-weight: 700; }
.name { font-size: 32rpx; font-weight: 600; }.hint { margin-top: 8rpx; color: #b9d0d6; font-size: 23rpx; }
.metrics { display: flex; background: #fff; margin: 20rpx 0; border-radius: 10rpx; }.metrics view { flex: 1; padding: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }.metrics view:first-child { border-right: 1rpx solid #edf1f2; }.metrics text:first-child { color: #176b80; font-size: 38rpx; font-weight: 700; }.metrics text:last-child { color: #7e8c91; font-size: 23rpx; }
.actions { display: flex; gap: 16rpx; }.actions button { flex: 1; margin: 0; background: #fff; color: #176b80; font-size: 26rpx; border: 1rpx solid #dce6e8; }.actions button::after { border: 0; }
.orders-head { margin-top: 30rpx; display: flex; justify-content: space-between; align-items: center; color: #24343a; font-size: 31rpx; font-weight: 600; }.orders-head button { margin: 0; padding: 0; color: #176b80; background: transparent; border: 0; font-size: 24rpx; }.orders-head button::after { border: 0; }
.state { padding: 100rpx 0; text-align: center; color: #87969b; font-size: 26rpx; }.error { margin-top: 20rpx; padding: 20rpx; background: #fff0ea; color: #a64e35; font-size: 24rpx; }
.order-card { margin-top: 18rpx; background: #fff; padding: 22rpx; border-radius: 10rpx; }.order-top, .order-bottom { display: flex; justify-content: space-between; align-items: center; }.order-top { color: #42545b; font-size: 24rpx; }.status { color: #176b80; }.items { margin: 18rpx 0; color: #263940; font-size: 27rpx; line-height: 1.5; }.order-bottom { color: #8c999d; font-size: 22rpx; }.amount { color: #a64e35; font-size: 31rpx; font-weight: 700; }

.history-list { white-space: nowrap; margin: 16rpx 0 28rpx; }.history-item { display: inline-flex; vertical-align: top; width: 170rpx; margin-right: 14rpx; padding: 14rpx; background: #fff; border-radius: 8rpx; flex-direction: column; gap: 10rpx; }.history-mark { height: 90rpx; display: flex; align-items: center; justify-content: center; background: #e5f0f1; color: #176b80; font-size: 25rpx; text-align: center; }.history-item text { color: #a64e35; font-size: 24rpx; }.cancel-order { margin: 16rpx 0 0; width: 100%; height: 58rpx; line-height: 58rpx; color: #a64e35; background: #fff4ef; border: 1rpx solid #f0c5b6; font-size: 23rpx; }.cancel-order::after { border: 0; }
.confirm-receipt { margin: 16rpx 0 0; width: 100%; height: 58rpx; line-height: 58rpx; color: #fff; background: #176b80; border: 0; font-size: 23rpx; }.confirm-receipt::after { border: 0; }
