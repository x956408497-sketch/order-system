<view class="mine-page">
  <view class="profile">
    <view class="avatar">订</view>
    <view><view class="name">{{nickname}}</view><view class="hint">{{loginHint}}</view></view>
  </view>

  <view class="metrics">
    <view><text>{{totalOrders}}</text><text>全部订单</text></view>
    <view><text>{{paidOrders}}</text><text>已支付订单</text></view>
  </view>

  <view class="actions">
    <button bindtap="goShop">继续选购</button>
    <button bindtap="goAddress">收货地址</button>
  </view>

  <view class="orders-head"><text>最近浏览</text><text class="muted">{{browseHistory.length}} 件</text></view>
  <scroll-view wx:if="{{browseHistory.length}}" class="history-list" scroll-x="true"><view wx:for="{{browseHistory}}" wx:key="id" class="history-item" data-id="{{item.id}}" bindtap="openHistory"><view class="history-mark">{{item.name}}</view><text>¥{{item.price}}</text></view></scroll-view>
  <view class="orders-head"><text>我的订单</text><button bindtap="refresh">刷新</button></view>
  <view wx:if="{{loading}}" class="state">正在加载订单...</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <view wx:elif="{{!orders.length}}" class="state">暂无订单</view>
  <view wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="order-card" data-order="{{item}}" bindtap="viewOrder">
      <view class="order-top"><text>订单号 {{item.orderNo}}</text><text class="status">{{item.statusText}}</text></view>
      <view class="items">{{item.itemSummary}}</view>
      <view class="order-bottom"><text>{{item.timeText}}</text><text class="amount">¥{{item.totalText}}</text></view>
      <view wx:if="{{item.canCancel}}" class="order-actions"><text class="pending-hint">{{item.countdownText}}</text><button class="cancel-order" data-order="{{item}}" catchtap="cancelOrder">取消订单</button></view>
      <button wx:if="{{item.orderStatus === 'SHIPPED'}}" class="confirm-receipt" data-order="{{item}}" catchtap="confirmReceipt">确认收货</button>
    </view>
  </view>
</view>
